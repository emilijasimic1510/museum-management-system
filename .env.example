# PostgreSQL
POSTGRES_DB=museum
POSTGRES_USER=museum_user
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_PORT=15432

# Neo4j: initial username must be neo4j; password at least 8 characters
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_local_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Locally running backend
BACKEND_PORT=8081
